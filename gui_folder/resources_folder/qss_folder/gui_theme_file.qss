/* GLOBAL */
QMainWindow {
    background-color: #F8FAFC;
}

QWidget {
    font-family: Segoe UI, Arial;
    font-size: 14px;
    color: #2D2433;
}

/* SIDEBAR */
QFrame#sidebar {
    background-color: #43364c;
    border: none;
}

QLabel#logoLabel {
    color: #FFFFFF;
    font-size: 28px;
    font-weight: 700;
    padding: 10px 4px;
}

QPushButton#menuButton {
    background-color: transparent;
    color: #EDE7F0;
    text-align: left;
    border: none;
    border-radius: 10px;
    padding: 12px 14px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton#menuButton:hover {
    background-color: #5a4864;
    color: #FFFFFF;
}

QPushButton#menuButton[active="true"] {
    background-color: #f37c20;
    color: #FFFFFF;
    font-weight: 700;
}

/* TITLES */
QLabel#pageTitle {
    font-size: 28px;
    font-weight: 700;
    color: #43364c;
    margin-bottom: 4px;
}

QLabel#subtitle {
    font-size: 14px;
    color: #7a6b85;
}

/* CARDS */
QFrame#card {
    background-color: #FFFFFF;
    border: 1px solid #E7E2EA;
    border-radius: 14px;
    padding: 18px;
}

QLabel#kpiTitle {
    font-size: 13px;
    color: #7a6b85;
    font-weight: 500;
}

QLabel#kpiValue {
    font-size: 28px;
    font-weight: 700;
    color: #43364c;
}

/* BUTTONS */
QPushButton {
    background-color: #FFFFFF;
    color: #43364c;
    border: 1px solid #D6CFDB;
    border-radius: 10px;
    padding: 10px 14px;
    font-size: 14px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F7F4F9;
    border: 1px solid #b8a9c4;
}

QPushButton:pressed {
    background-color: #EDE7F0;
}

QPushButton#primaryButton {
    background-color: #f37c20;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}

QPushButton#primaryButton:hover {
    background-color: #d96f1c;
}

QPushButton#primaryButton:pressed {
    background-color: #b85c16;
}

/* TABLES */
QTableWidget {
    background-color: #FFFFFF;
    color: #2D2433;
    border: 1px solid #E7E2EA;
    border-radius: 12px;
    gridline-color: #E7E2EA;
    selection-background-color: #f37c20;
    selection-color: #FFFFFF;
    outline: 0;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:selected {
    background-color: #f37c20;
    color: #FFFFFF;
}

QHeaderView::section {
    background-color: #F7F4F9;
    color: #43364c;
    padding: 10px;
    border: none;
    border-bottom: 1px solid #E7E2EA;
    font-weight: 600;
}

QTableCornerButton::section {
    background-color: #F7F4F9;
    border: none;
    border-bottom: 1px solid #E7E2EA;
}

/* TABS */
QTabWidget {
    background-color: #F8FAFC;
}

QTabWidget::pane {
    background-color: #F8FAFC;
    border: 1px solid #E7E2EA;
    border-radius: 12px;
}

QTabBar {
    background-color: #F8FAFC;
}

QTabBar::tab {
    background-color: #F7F4F9;
    color: #43364c;
    padding: 10px 16px;
    margin-right: 6px;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
}

QTabBar::tab:hover {
    background-color: #F2ECF6;
}

QTabBar::tab:selected {
    background-color: #f37c20;
    color: #FFFFFF;
}

QMainWindow#floatingConsultationWindow {
    background-color: #F8FAFC;
}

QTextEdit {
    background-color: #FFFFFF;
    color: #2D2433;
    border: 1px solid #E7E2EA;
    border-radius: 12px;
    padding: 10px;
}

QTextEdit:focus {
    border: 1px solid #f37c20;
}

/* MESSAGE BOX */
QMessageBox {
    background-color: #FFFFFF;
    color: #2D2433;
}

QMessageBox QLabel {
    color: #2D2433;
    background-color: transparent;
    font-size: 14px;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* PROGRESS BAR */
QProgressBar {
    background-color: #E7E2EA;
    border: none;
    border-radius: 8px;
    height: 18px;
    text-align: center;
    color: #43364c;
    font-weight: 600;
}

QProgressBar::chunk {
    background-color: #f37c20;
    border-radius: 8px;
}
